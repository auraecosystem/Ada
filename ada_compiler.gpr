project Ada_Compiler is
   for Languages use ("Ada");
   for Source_Dirs use ("src", "cli");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("ada_compiler_cli.adb");

   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnatwa", "-gnatwe");
   end Compiler;
end Ada_Compiler;
